@enterprise_ecommerce_api_HostAddress = http://localhost:5162

### delete product by id
DELETE {{enterprise_ecommerce_api_HostAddress}}/api/Products/1
Accept: application/json

### get product by id

GET {{enterprise_ecommerce_api_HostAddress}}/api/Products/1
Accept: application/json

### get all products
GET {{enterprise_ecommerce_api_HostAddress}}/api/Products/
Accept: application/json

